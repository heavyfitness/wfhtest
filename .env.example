# ── WordPress ────────────────────────────────────────────────────────────────
# Your site root (no trailing slash needed). The client appends /wp-json/wp/v2.
WP_URL=https://thewfhconnect.com
# Must be your WP account EMAIL address — not the username slug.
WP_USERNAME=benmusick54@gmail.com
# Application Password (WP Admin → Users → Profile → Application Passwords).
# Spaces are fine — keep the quotes.
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# ── LLM backend ──────────────────────────────────────────────────────────────
# anthropic (default) | ollama
LLM_BACKEND=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only used when LLM_BACKEND=ollama (e.g. a local RTX 3090 box)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Google Sheets lead source ────────────────────────────────────────────────
# The long ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_WORKSHEET=Leads
# Path to the service-account JSON key (share the sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# ── Content ──────────────────────────────────────────────────────────────────
# JSON array of affiliate links rendered into a "Recommended tools" section.
# Leave empty to skip the section entirely.
AFFILIATE_LINKS=[]

# ── Pipeline behaviour ───────────────────────────────────────────────────────
TIMEZONE=America/New_York
POSTS_PER_RUN=3
# draft | publish | future  (draft is the safe default)
DEFAULT_POST_STATUS=draft
# Local times (in TIMEZONE) used to spread `--schedule` posts across the day
SCHEDULE_TIMES=08:00,12:00,16:00

# ── Storage & logging ────────────────────────────────────────────────────────
# IMPORTANT: must be a native filesystem path, not a Windows-mounted path.
# Use /tmp/wfh_pipeline_state.db on Linux/Mac, or a WSL-native path on Windows.
DB_PATH=/tmp/wfh_pipeline_state.db
LOG_FILE=logs/pipeline.log

# ── Link classification — domain overrides ───────────────────────────────────
# Add comma-separated domains here to extend the built-in direct/aggregator lists.
EXTRA_DIRECT_DOMAINS=
EXTRA_AGGREGATOR_DOMAINS=

# ── Lane policy ──────────────────────────────────────────────────────────────
# Set to true ONLY after manually verifying every aggregator lead has a real
# direct apply URL. Default: false (aggregator leads always post as draft).
ALLOW_AGGREGATOR_AUTOPUBLISH=false

# ── Optional Job API (JSearch / RapidAPI) ────────────────────────────────────
# Off by default. To activate:
#   1. Sign up at https://rapidapi.com and subscribe to JSearch (free tier ok).
#   2. Set ENABLE_JOB_API=true and paste your key below.
ENABLE_JOB_API=false
JOB_API_KEY=

# Comma-separated search queries (each run separately, results combined + deduped).
# These defaults target WFH Connect's audience: entry-level CS / data-entry roles.
# Override to customise without changing code.
JOB_API_QUERIES=remote customer service no experience,remote data entry no experience,remote chat support entry level,virtual assistant remote,remote customer support associate

# Max results to fetch per query (10 per API page, so 20 = 2 pages per query).
JOB_API_MAX_RESULTS=20

# ── Relevance / quality filter ───────────────────────────────────────────────
# Controls which job titles pass through before LLM generation. Saves API cost
# by skipping senior/engineering roles that don't fit WFH Connect's audience.
#
# RELEVANCE_INCLUDE_KEYWORDS: at least ONE of these must appear in the job title
#   or description for the lead to be kept. Comma-separated, case-insensitive.
#   Leave blank to use the built-in defaults (customer service, data entry, etc.)
RELEVANCE_INCLUDE_KEYWORDS=

# RELEVANCE_EXCLUDE_TITLE: if ANY of these appear in the job TITLE, the lead
#   is rejected regardless of include keywords. Comma-separated, case-insensitive.
#   Leave blank to use the built-in defaults (senior, staff, principal, engineer…)
RELEVANCE_EXCLUDE_TITLE=

# RELEVANCE_PERMISSIVE: set to true to disable the include-keyword requirement
#   (only the exclude list applies). Useful for small boards where you trust all titles.
RELEVANCE_PERMISSIVE=false
